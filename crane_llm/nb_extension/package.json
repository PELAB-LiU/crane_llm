{
  "name": "crane-llm-jlab",
  "version": "0.0.0",
  "description": "CRANE-LLM native JupyterLab/Notebook 7 extension",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "jlpm build:lib && jlpm build:labextension:dev",
    "build:prod": "jlpm clean:all && jlpm build:lib:prod && jlpm build:labextension",
    "build:labextension": "node ./node_modules/@jupyter/builder/lib/build-labextension.js --core-package-file ./node_modules/@jupyterlab/core-meta/core.package.json . && node scripts/fix-build-load.mjs",
    "build:labextension:dev": "node ./node_modules/@jupyter/builder/lib/build-labextension.js --development --core-package-file ./node_modules/@jupyterlab/core-meta/core.package.json . && node scripts/fix-build-load.mjs",
    "build:lib": "tsc --sourceMap",
    "build:lib:prod": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "clean": "jlpm clean:lib",
    "clean:lib": "node scripts/clean.mjs lib tsconfig.tsbuildinfo",
    "clean:labextension": "node scripts/clean.mjs labextension",
    "clean:all": "jlpm clean:lib && jlpm clean:labextension"
  },
  "files": [
    "lib/**/*",
    "package.json",
    "scripts/**/*"
  ],
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/apputils": "^4.0.0",
    "@jupyterlab/notebook": "^4.0.0",
    "@jupyterlab/services": "^7.0.0",
    "@lumino/widgets": "^2.0.0"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.0.0",
    "@rspack/core": "2.0.2",
    "typescript": "^5.5.4"
  },
  "resolutions": {
    "@rspack/core": "2.0.2",
    "glob": "13.0.5",
    "fast-uri": "3.1.3"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension",
    "sharedPackages": {
      "@jupyterlab/application": {
        "singleton": true
      },
      "@jupyterlab/apputils": {
        "singleton": true
      },
      "@jupyterlab/notebook": {
        "singleton": true
      },
      "@jupyterlab/services": {
        "singleton": true
      },
      "@lumino/widgets": {
        "singleton": true
      }
    }
  }
}
